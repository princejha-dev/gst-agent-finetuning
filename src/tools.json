        "type": "object",
        "properties": {
          "gstin": {
            "type": "string"
          }
        },
        "required": [
          "gstin"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "calculate_interest",
      "description": "Interest on delayed GST payment at 18% per annum (simple interest, days/365).",
      "parameters": {
        "type": "object",
        "properties": {
          "tax_amount": {
            "type": "number"
          },
          "days_late": {
            "type": "integer"
          }
        },
        "required": [
          "tax_amount",
          "days_late"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_filing_due_date",
