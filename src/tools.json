[
  {
    "type": "function",
    "function": {
      "name": "calculate_gst",
      "description": "Calculate GST on an amount, either added on top (exclusive) or extracted from a GST-inclusive price.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount in INR"
          },
          "rate": {
            "type": "number",
            "description": "GST rate in percent, e.g. 5, 18, 40"
          },
          "mode": {
            "type": "string",
            "enum": [
              "exclusive",
              "inclusive"
            ],
            "description": "Whether amount excludes or includes GST"
          }
        },
        "required": [
          "amount",
          "rate",
          "mode"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "split_gst",
      "description": "Split a GST amount into CGST+SGST (intra-state) or IGST (inter-state).",
      "parameters": {
        "type": "object",
        "properties": {
          "gst_amount": {
            "type": "number"
          },
          "supply_type": {
            "type": "string",
            "enum": [
              "intra_state",
              "inter_state"
            ]
          }
        },
        "required": [
          "gst_amount",
          "supply_type"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "determine_supply_type",
      "description": "Decide whether a supply is intra-state or inter-state from seller and buyer (place of supply) states.",
      "parameters": {
        "type": "object",
        "properties": {
          "seller_state": {
            "type": "string"
          },
          "buyer_state": {
            "type": "string"
          }
        },
        "required": [
          "seller_state",
          "buyer_state"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_gst_rate",
      "description": "Look up the GST rate for a goods/service item from the reference table.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "Item name in lowercase, e.g. 'shampoo'"
          }
        },
        "required": [
          "item"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "validate_gstin",
